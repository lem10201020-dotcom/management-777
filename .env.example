# Supabase → Project Settings → Database → Connection string
# 운영(Vercel)에서는 Transaction pooler(포트 6543) 주소를 권장합니다.
DATABASE_URL=postgresql://postgres.xxxxxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:6543/postgres
# 32자 이상 임의 문자열 (예: openssl rand -hex 32)
SESSION_SECRET=change-me-to-a-long-random-string-32chars
APP_TIMEZONE=Asia/Seoul
